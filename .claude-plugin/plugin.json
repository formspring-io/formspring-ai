{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "formspring",
  "displayName": "Formspring",
  "description": "Create and manage Formspring forms, surveys, funnels, links, and automations from Claude Code via the Formspring MCP server.",
  "version": "1.1.1",
  "author": {
    "name": "Formspring",
    "url": "https://formspring.io"
  },
  "homepage": "https://formspring.io/mcp",
  "logo": "assets/logo.png",
  "repository": "https://github.com/formspring-io/formspring-ai.git",
  "license": "MIT",
  "keywords": [
    "formspring",
    "forms",
    "surveys",
    "funnels",
    "mcp",
    "lead-gen",
    "submissions"
  ],
  "mcpServers": "./.mcp.json",
  "skills": "./skills/",
  "commands": "./commands/",
  "hooks": "./hooks/hooks.json",
  "userConfig": {
    "formspring_token": {
      "type": "string",
      "title": "Formspring API token",
      "description": "Bearer token from https://formspring.io/api or the MCP setup wizard",
      "sensitive": true,
      "required": true
    }
  }
}
